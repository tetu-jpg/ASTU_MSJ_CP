class Solution:
    def findContentChildren(self, g: List[int], s: List[int]) -> int:
        count=0
        s.sort()
        g.sort()
        i=0
        j=0
        while i < len(g) and j < len(s):
          if g[i]<=s[j]:  
                count+=1
                j+=1
                i+=1
          elif g[i]<s[j]:
                i+=1
          else:
              j+=1
        return count
