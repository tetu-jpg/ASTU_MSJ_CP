t=int(input())
for _ in range(t):
    n=int(input())
    matrix=[]
    ans=[0]*(2*n + 1)
    for i in range(n):
        row=list(map(int,input().split()))
        matrix.append(row)
    for i in range(n):
        for j in range(n):
            ans[i+j+2]=matrix[i][j]
    visit=[False]*(2*n+1)
    for i in range(2,2*n + 1 ):
        visit[ans[i]]=True

    for i in range(1,2*n+1):
        if not visit[i]:
            ans[1]=i
            break

    print(*ans[1:])
        





